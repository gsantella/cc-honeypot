{
    "compilerOptions": {
      "target": "es6",
      "module": "ES6",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "dist/",
      "baseUrl": "./",
      "paths": {
        "@models/*": ["src/models/*"]
      }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }